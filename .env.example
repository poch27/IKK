# Drop waitlist configuration. All values are server-only; never add NEXT_PUBLIC_ variants.
# Exact origin visitors use (scheme + host, no trailing slash); submissions from other origins are rejected.
APP_ORIGIN=http://localhost:3000
# Brand Instagram profile URL shown in the page footer.
APPROVED_INSTAGRAM_URL=https://www.instagram.com/your-brand-handle/
# Monitored inbox for consent withdrawal, deletion requests, and privacy questions.
PRIVACY_CONTACT_EMAIL=privacy@example.com
# Neon pooled Postgres connection string with TLS required.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# HMAC key for rate-limit digests; generate with: openssl rand -base64 32
RATE_LIMIT_SECRET=change-me
# Bearer secret Vercel Cron sends to /api/waitlist-maintenance; generate with: openssl rand -base64 32
CRON_SECRET=change-me
